# Copy to .env.local and fill in. Never put a real key in this file.
# Get one free at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash (~6s per briefing). gemini-3.7-flash
# also works but measured ~19s on the rich-context preset, which is too slow to
# demo live.
# GEMINI_MODEL=gemini-3.5-flash

# Optional. LOW | MEDIUM | HIGH — how long Gemini 3.x reasons before answering.
# Default LOW keeps it fast for a live audience. Not every model accepts every
# level (3.7-flash rejects MINIMAL), and a bad value surfaces as a 400.
# GEMINI_THINKING_LEVEL=LOW

# Optional. Only used if GEMINI_MODEL is set to a 2.5-series model, which takes
# a numeric budget instead of a level. 0 disables thinking entirely.
# GEMINI_THINKING_BUDGET=0
